# Copy to .env.local (never commit it). On Vercel, set the same names under Settings → Environment Variables.

# Password for the /admin analytics page (8+ characters).
ADMIN_PASSWORD=

# Where the analytics numbers are kept. Leave both empty while developing: a local file is used instead.
# After deploying the stats service (stats/), put its address here and the shared secret it was started with.
STATS_URL=
STATS_SECRET=
